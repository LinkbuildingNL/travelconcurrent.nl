---
import BaseLayout from '../layouts/BaseLayout.astro';

const partners = [
  {
    naam: 'Travel Essence',
    url: 'https://www.travelessence.nl/',
    beschrijving: 'Travel Essence organiseert reizen op maat naar bestemmingen buiten Europa.',
    anchor: 'Travel Essence',
  },
  {
    naam: 'Little America',
    url: 'https://www.littleamerica.nl/',
    beschrijving: 'Little America is gespecialiseerd in reizen naar de Verenigde Staten en Canada.',
    anchor: 'Little America',
  },
  {
    naam: 'Domstadboot',
    url: 'https://domstadboot.nl/',
    beschrijving: 'Domstadboot verzorgt sloeptochten met schipper door de grachten van Utrecht.',
    anchor: 'bootje varen utrecht',
  },
  {
    naam: 'Milieustickerkopen.nl',
    url: 'https://milieustickerkopen.nl/milieusticker-frankrijk',
    beschrijving: "Milieustickerkopen.nl helpt bij het aanvragen van de Franse milieusticker (Crit'Air) voor een reis naar Frankrijk.",
    anchor: 'Franse milieusticker',
  },
  {
    naam: 'Horecarama',
    url: 'https://www.horecarama.nl/klein-materiaal/voedsel-bakken-en-dozen/plastic-bakjes/',
    beschrijving: 'Horecarama levert plastic afhaalbakjes, onder meer geschikt voor onderweg tijdens een reis.',
    anchor: 'Plastic afhaalbakjes',
  },
  {
    naam: 'Travel Your Memories',
    url: 'https://travelyourmemories.nl/reis-op-maat/japan/',
    beschrijving: 'Travel Your Memories stelt reizen op maat samen, waaronder rondreizen door Japan.',
    anchor: 'Reis Japan',
  },
  {
    naam: "Charlie's Travels",
    url: 'https://charlies-travels.com/doelgroep/lustrumreis/',
    beschrijving: "Charlie's Travels organiseert groepsreizen naar Afrika, waaronder lustrumreizen.",
    anchor: 'lustrumreis naar Afrika',
  },
  {
    naam: 'Ontdek Emmen',
    url: 'https://ontdekemmen.nl/tips/bezienswaardigheden-drenthe/',
    beschrijving: 'Ontdek Emmen zet de mooiste uitstapjes en bezienswaardigheden in Emmen en de rest van Drenthe op een rij.',
    anchor: 'Drenthe bezienswaardigheden',
  },
  {
    naam: 'eSailing',
    url: 'https://esailing.nl/boot-merken/victoire',
    beschrijving: 'eSailing biedt zeilboten en jachten aan voor wie een zeilvakantie of eigen boot overweegt, waaronder boten van het merk Victoire.',
    anchor: 'Victoire',
  },
  {
    naam: 'Voetbalticketshop',
    url: 'https://voetbalticketshop.nl/voetbaltickets-spanje/fc-barcelona-tickets/',
    beschrijving:
      'Voetbalticketshop verkoopt tickets voor wedstrijden van Europese clubs, waaronder FC Barcelona.',
    anchor: 'FC Barcelona tickets',
  },
];
---
<BaseLayout
  title="Partners — TravelConcurrent"
  description="Partners en bronnen waar TravelConcurrent naar verwijst."
>
  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">Partners</span>
      <h1>Partners en bronnen</h1>
      <p class="lede">TravelConcurrent verwijst hier naar externe partners en bronnen.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {partners.map((partner) => (
          <div class="card">
            <h3><a href={partner.url} target="_blank" rel="noopener">{partner.naam}</a></h3>
            <p>{partner.beschrijving}</p>
            <a class="card-link" href={partner.url} target="_blank" rel="noopener">{partner.anchor}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
